# Copy this file to .env and fill in real values. docker-compose.yml and
# `go run ./backend/cmd/server` (via godotenv-free plain os.Getenv — export
# these yourself, or use `set -a; source .env; set +a`) both read from the
# environment; see backend/internal/config/config.go for the authoritative
# list and defaults.

# --- Server -----------------------------------------------------------
PORT=8080
TEAHUB_ENV=development          # development | production | test

# --- Database -----------------------------------------------------------
# Standard postgres:// DSN. The docker-compose default matches the `db`
# service below. In production this should point at Cloud SQL (see
# deploy/cloudrun.md) with sslmode=require or a Cloud SQL Auth Proxy socket.
DATABASE_URL=postgres://teahub:teahub@localhost:5432/teahub?sslmode=disable

# Set to "true" ONLY for local hacking with zero DB setup. Repository
# metadata will NOT survive a restart in this mode. Never set in production
# (config.Load will still allow it, but nothing else should rely on this).
TEAHUB_IN_MEMORY_STORE=false

# --- Auth: GitHub OAuth App --------------------------------------------
# Create one at https://github.com/settings/developers -> "New OAuth App".
# Authorization callback URL must exactly match GITHUB_OAUTH_REDIRECT_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/auth/github/callback

# --- Sessions -----------------------------------------------------------
# Required in production; must be >= 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=
SESSION_TTL=168h                # 7 days
SECURE_COOKIES=false            # set true in any deployment served over HTTPS

# --- AI (Anthropic) -----------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Storage --------------------------------------------------------------
REPO_STORAGE_DIR=./data/repos

# --- CORS (only needed if the frontend is served from a different origin
# than the API; leave blank for the default same-origin setup) ----------
FRONTEND_ORIGIN=

# --- Request limits -------------------------------------------------------
# All have working defaults (shown below); only set these if you need to
# change them. See backend/internal/config/config.go for details.
MAX_REQUEST_BODY_BYTES=1048576  # 1 MiB
MAX_QUESTION_LENGTH=4000
MAX_SEARCH_QUERY_LENGTH=500

# --- Rate limiting (per-instance token bucket; see ARCHITECTURE.md) -----
IMPORT_RATE_LIMIT_PER_MIN=5
IMPORT_RATE_LIMIT_BURST=3
ASK_RATE_LIMIT_PER_MIN=20
ASK_RATE_LIMIT_BURST=10

# --- Demo Mode (optional) ------------------------------------------------
# Set this to turn on a handful of unauthenticated, read-only endpoints
# (GET /api/demo, /api/demo/file, POST /api/demo/ask|search|diagram)
# backed by exactly one repository, cloned + indexed once at startup —
# so anyone with the link can try TeaHub's real features with zero setup
# (no GitHub OAuth, no account). Leave blank to disable Demo Mode
# entirely (the default) — an unset value adds no routes and no cost.
# Accepts the same "owner/repo" shorthand or full URL as a normal import.
DEMO_REPO_URL=
# Anonymous demo traffic is rate-limited by caller IP (not by user, since
# there's no login) on the two AI-cost-bearing demo endpoints. Deliberately
# tighter than ASK_RATE_LIMIT_* above — this is protecting your Anthropic
# API budget from a publicly linked, unauthenticated page.
DEMO_ASK_RATE_LIMIT_PER_MIN=6
DEMO_ASK_RATE_LIMIT_BURST=3
